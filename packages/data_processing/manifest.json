    {
      "algorithm_id": "invalid_sample_handling",
      "display_name": "无效样本处理",
      "display_name_en": "Invalid Sample Handling",
      "category": "data_processing",
      "category_display_name": "数据处理",
      "category_display_name_en": "Data Processing",
      "description": "使用安全的白名单规则识别、标记或删除无效记录。",
      "description_en": "Uses safe allow-listed rules to detect, flag, or remove invalid records.",
      "methods": [
        {"method_id": "rule_based", "display_name": "单规则判断", "display_name_en": "Single-rule Validation", "entry": "algorithms.invalid_sample_handling:run_rule_based", "description": "执行一条预设有效性规则。", "description_en": "Runs one predefined validity rule.", "input": {"data_type": "table", "slots": [{"id": "check_columns", "display_name": "检查变量", "display_name_en": "Variables to Check", "type": "columns", "required": true, "min_items": 2, "allowed_data_types": ["integer", "number", "string", "boolean", "datetime", "category"], "allowed_analysis_types": ["categorical", "quantitative"]}], "constraints": []}, "parameters_schema": {"type": "object", "properties": {
          "rules": {"type": "array", "title": "判断规则", "x-title-en": "Validation Rule", "description": "配置一条白名单规则；不满足规则的样本将被判为无效。", "x-description-en": "Configure one allow-listed rule; samples that fail it are invalid.", "x-ui-control": "json-editor", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/rule"}},
