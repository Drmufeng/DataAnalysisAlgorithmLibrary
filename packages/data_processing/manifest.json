{
  "protocol_version": "1.1",
  "package_id": "data_processing",
  "package_name": "数据处理算法包",
  "package_name_en": "Data Processing Algorithm Package",
  "version": "0.2.0",
  "publisher": "项目组",
  "description": "提供数据编码、异常值处理和无效样本处理，并始终返回新的数据副本。",
  "description_en": "Provides data encoding, outlier handling, and invalid-sample handling while always returning a new data copy.",
  "runtime": {"python": ">=3.11,<3.13", "dependencies": [
    {"name": "pandas", "version": ">=2.2,<3.0"},
    {"name": "numpy", "version": ">=1.26,<3.0"},
    {"name": "scipy", "version": ">=1.13,<2.0"},
    {"name": "pydantic", "version": ">=2.8,<3.0"}
  ]},
  "algorithms": [
    {
      "algorithm_id": "data_encoding",
      "display_name": "数据编码",
      "display_name_en": "Data Encoding",
      "category": "data_processing",
      "category_display_name": "数据处理",
      "category_display_name_en": "Data Processing",
      "description": "使用手工映射、数值范围或自动分箱生成编码字段。",
      "description_en": "Creates encoded fields using manual mappings, numeric ranges, or automatic binning.",
      "methods": [
        {
          "method_id": "manual",
          "display_name": "新编码",
          "display_name_en": "Manual Recoding",
          "entry": "algorithms.data_encoding:run_manual",
          "description": "将明确的原值映射为新值。",
          "description_en": "Maps explicit source values to new values.",
          "input": {"data_type": "table", "slots": [{"id": "source_column", "display_name": "待编码变量", "display_name_en": "Variable to Recode", "type": "column", "required": true, "min_items": 1, "max_items": 1, "allowed_data_types": ["integer", "number", "string", "boolean", "category"], "allowed_analysis_types": ["categorical", "quantitative"]}], "constraints": []},
          "parameters_schema": {"type": "object", "properties": {
            "mapping": {"type": "object", "title": "编码映射", "x-title-en": "Value Mapping", "description": "填写原值与新值的对应关系。", "x-description-en": "Define source-to-target value mappings.", "x-ui-control": "json-editor", "minProperties": 1, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
            "unmatched": {"type": "string", "title": "未匹配值处理", "x-title-en": "Unmatched Values", "enum": ["keep", "null", "error"], "oneOf": [{"const": "keep", "title": "保留原值", "x-title-en": "Keep Original"}, {"const": "null", "title": "置为空值", "x-title-en": "Set as Missing"}, {"const": "error", "title": "停止并报错", "x-title-en": "Stop with Error"}], "default": "keep"},
            "include_missing": {"type": "boolean", "title": "包含缺失值", "x-title-en": "Include Missing Values", "description": "是否将缺失值纳入映射。", "x-description-en": "Whether missing values participate in the mapping.", "default": false},
            "output_mode": {"type": "string", "title": "输出方式", "x-title-en": "Output Mode", "enum": ["new_column", "replace"], "oneOf": [{"const": "new_column", "title": "生成新变量", "x-title-en": "Create New Variable"}, {"const": "replace", "title": "替换原变量", "x-title-en": "Replace Source Variable"}], "default": "new_column"},
            "output_column_name": {"type": "string", "title": "新变量名称", "x-title-en": "New Variable Name", "description": "输出方式为生成新变量时使用。", "x-description-en": "Used when the output mode creates a new variable.", "x-visible-when": {"field": "output_mode", "equals": "new_column"}, "minLength": 1, "maxLength": 128, "default": "encoded_value"}
          }, "required": ["mapping"], "additionalProperties": false},
          "output": {"data_type": "table", "produces_data_version": true},
          "deterministic": true
        },
        {
          "method_id": "range",
          "display_name": "范围编码",
          "display_name_en": "Range Recoding",
          "entry": "algorithms.data_encoding:run_range",
          "description": "按互不重叠的左闭右开范围编码。",
          "description_en": "Recodes values using non-overlapping left-closed, right-open ranges.",
          "input": {"data_type": "table", "slots": [{"id": "source_column", "display_name": "定量变量", "display_name_en": "Quantitative Variable", "type": "column", "required": true, "min_items": 1, "max_items": 1, "allowed_data_types": ["integer", "number"], "allowed_analysis_types": ["quantitative"]}], "constraints": []},
          "parameters_schema": {"type": "object", "properties": {
            "ranges": {"type": "array", "title": "范围编码规则", "x-title-en": "Range Rules", "description": "按最小值、最大值和目标值填写编码区间。", "x-description-en": "Define each interval with lower bound, upper bound, and target value.", "x-ui-control": "json-editor", "minItems": 1, "items": {"type": "object", "properties": {"minimum": {"type": ["number", "null"]}, "maximum": {"type": ["number", "null"]}, "value": {"type": ["string", "number", "integer", "boolean", "null"]}}, "required": ["value"], "additionalProperties": false}},
            "unmatched": {"type": "string", "title": "未匹配值处理", "x-title-en": "Unmatched Values", "enum": ["keep", "null", "error"], "oneOf": [{"const": "keep", "title": "保留原值", "x-title-en": "Keep Original"}, {"const": "null", "title": "置为空值", "x-title-en": "Set as Missing"}, {"const": "error", "title": "停止并报错", "x-title-en": "Stop with Error"}], "default": "keep"},
            "include_missing": {"type": "boolean", "title": "包含缺失值", "x-title-en": "Include Missing Values", "default": false},
            "output_mode": {"type": "string", "title": "输出方式", "x-title-en": "Output Mode", "enum": ["new_column", "replace"], "oneOf": [{"const": "new_column", "title": "生成新变量", "x-title-en": "Create New Variable"}, {"const": "replace", "title": "替换原变量", "x-title-en": "Replace Source Variable"}], "default": "new_column"},
            "output_column_name": {"type": "string", "title": "新变量名称", "x-title-en": "New Variable Name", "x-visible-when": {"field": "output_mode", "equals": "new_column"}, "minLength": 1, "maxLength": 128, "default": "encoded_value"}
          }, "required": ["ranges"], "additionalProperties": false},
          "output": {"data_type": "table", "produces_data_version": true},
          "deterministic": true
        },
        {
          "method_id": "auto_bin",
          "display_name": "自动分组",
          "display_name_en": "Automatic Binning",
          "entry": "algorithms.data_encoding:run_auto_bin",
          "description": "按等宽或等频规则自动分箱并生成组号。",
          "description_en": "Automatically bins values by equal width or equal frequency and creates group codes.",
          "input": {"data_type": "table", "slots": [{"id": "source_column", "display_name": "定量变量", "display_name_en": "Quantitative Variable", "type": "column", "required": true, "min_items": 1, "max_items": 1, "allowed_data_types": ["integer", "number"], "allowed_analysis_types": ["quantitative"]}], "constraints": []},
          "parameters_schema": {"type": "object", "properties": {
            "bin_method": {"type": "string", "title": "分组方法", "x-title-en": "Binning Method", "enum": ["equal_width", "equal_frequency"], "oneOf": [{"const": "equal_width", "title": "等宽分组", "x-title-en": "Equal Width"}, {"const": "equal_frequency", "title": "等频分组", "x-title-en": "Equal Frequency"}], "default": "equal_width"},
            "bin_count": {"type": "integer", "title": "分组数量", "x-title-en": "Number of Bins", "description": "设置自动生成的分组个数。", "x-description-en": "Sets the number of automatically generated bins.", "minimum": 2, "maximum": 100, "default": 5},
            "output_mode": {"type": "string", "title": "输出方式", "x-title-en": "Output Mode", "enum": ["new_column", "replace"], "oneOf": [{"const": "new_column", "title": "生成新变量", "x-title-en": "Create New Variable"}, {"const": "replace", "title": "替换原变量", "x-title-en": "Replace Source Variable"}], "default": "new_column"},
            "output_column_name": {"type": "string", "title": "新变量名称", "x-title-en": "New Variable Name", "x-visible-when": {"field": "output_mode", "equals": "new_column"}, "minLength": 1, "maxLength": 128, "default": "encoded_group"}
          }, "additionalProperties": false},
          "output": {"data_type": "table", "produces_data_version": true},
          "deterministic": true
        }
      ]
    },
    {
      "algorithm_id": "outlier_handling",
      "display_name": "异常值处理",
      "display_name_en": "Outlier Handling",
      "category": "data_processing",
      "category_display_name": "数据处理",
      "category_display_name_en": "Data Processing",
      "description": "识别定量变量异常值并按可控策略处置。",
      "description_en": "Detects outliers in quantitative variables and handles them using a selected strategy.",
      "methods": [
        {"method_id": "auto", "display_name": "自动识别", "display_name_en": "Automatic Detection", "entry": "algorithms.outlier_handling:run_auto", "description": "按偏度自动选择 IQR 或 MAD。", "description_en": "Automatically selects IQR or MAD according to skewness.", "input": {"data_type": "table", "slots": [{"id": "x_columns", "display_name": "定量变量", "display_name_en": "Quantitative Variables", "type": "columns", "required": true, "min_items": 1, "allowed_data_types": ["integer", "number"], "allowed_analysis_types": ["quantitative"]}], "constraints": []}, "parameters_schema": {"type": "object", "properties": {
          "action": {"type": "string", "title": "处置方式", "x-title-en": "Treatment", "enum": ["set_null", "custom_value", "mean", "median", "mode", "zero", "random_valid_value", "winsorize"], "oneOf": [{"const": "set_null", "title": "置为空值", "x-title-en": "Set as Missing"}, {"const": "custom_value", "title": "自定义值替换", "x-title-en": "Replace with Custom Value"}, {"const": "mean", "title": "均值替换", "x-title-en": "Replace with Mean"}, {"const": "median", "title": "中位数替换", "x-title-en": "Replace with Median"}, {"const": "mode", "title": "众数替换", "x-title-en": "Replace with Mode"}, {"const": "zero", "title": "数字 0 替换", "x-title-en": "Replace with Zero"}, {"const": "random_valid_value", "title": "随机有效值替换", "x-title-en": "Replace with Random Valid Value"}, {"const": "winsorize", "title": "缩尾处理", "x-title-en": "Winsorize"}], "default": "set_null"},
          "replacement_value": {"type": "number", "title": "自定义替换值", "x-title-en": "Custom Replacement Value", "x-visible-when": {"field": "action", "equals": "custom_value"}, "default": 0},
          "bounds": {"type": "object", "title": "字段边界覆盖", "x-title-en": "Per-variable Bounds", "description": "可选；用于覆盖自动计算的字段上下界。", "x-description-en": "Optional per-variable overrides for calculated bounds.", "x-ui-control": "json-editor", "default": {}},
          "threshold": {"type": "number", "title": "MAD 阈值", "x-title-en": "MAD Threshold", "description": "标准化绝对偏差超过该值时判为异常。", "x-description-en": "Values above this standardized absolute-deviation threshold are outliers.", "exclusiveMinimum": 0, "default": 3.5},
          "k": {"type": "number", "title": "IQR 阈值系数", "x-title-en": "IQR Multiplier", "description": "用于计算四分位距上下界。", "x-description-en": "Multiplier used to calculate IQR bounds.", "exclusiveMinimum": 0, "default": 1.5}
        }, "additionalProperties": false}, "output": {"data_type": "table", "produces_data_version": true}, "deterministic": true},
        {"method_id": "custom", "display_name": "自定义识别", "display_name_en": "Custom Bounds", "entry": "algorithms.outlier_handling:run_custom", "description": "按每个字段的自定义上下限识别。", "description_en": "Detects outliers using custom lower and upper bounds for each variable.", "input": {"data_type": "table", "slots": [{"id": "x_columns", "display_name": "定量变量", "display_name_en": "Quantitative Variables", "type": "columns", "required": true, "min_items": 1, "allowed_data_types": ["integer", "number"], "allowed_analysis_types": ["quantitative"]}], "constraints": []}, "parameters_schema": {"type": "object", "properties": {
          "action": {"type": "string", "title": "处置方式", "x-title-en": "Treatment", "enum": ["set_null", "custom_value", "mean", "median", "mode", "zero", "random_valid_value", "winsorize"], "oneOf": [{"const": "set_null", "title": "置为空值", "x-title-en": "Set as Missing"}, {"const": "custom_value", "title": "自定义值替换", "x-title-en": "Replace with Custom Value"}, {"const": "mean", "title": "均值替换", "x-title-en": "Replace with Mean"}, {"const": "median", "title": "中位数替换", "x-title-en": "Replace with Median"}, {"const": "mode", "title": "众数替换", "x-title-en": "Replace with Mode"}, {"const": "zero", "title": "数字 0 替换", "x-title-en": "Replace with Zero"}, {"const": "random_valid_value", "title": "随机有效值替换", "x-title-en": "Replace with Random Valid Value"}, {"const": "winsorize", "title": "缩尾处理", "x-title-en": "Winsorize"}], "default": "set_null"},
          "replacement_value": {"type": "number", "title": "自定义替换值", "x-title-en": "Custom Replacement Value", "x-visible-when": {"field": "action", "equals": "custom_value"}, "default": 0},
          "bounds": {"type": "object", "title": "自定义上下限", "x-title-en": "Custom Bounds", "description": "按变量填写最小值和最大值。", "x-description-en": "Define lower and upper bounds for each variable.", "x-ui-control": "json-editor", "minProperties": 1, "additionalProperties": {"type": "object", "properties": {"minimum": {"type": ["number", "null"]}, "maximum": {"type": ["number", "null"]}}, "additionalProperties": false}}
        }, "required": ["bounds"], "additionalProperties": false}, "output": {"data_type": "table", "produces_data_version": true}, "deterministic": true},
        {"method_id": "mad", "display_name": "中位数绝对偏差法", "display_name_en": "Median Absolute Deviation (MAD)", "entry": "algorithms.outlier_handling:run_mad", "description": "使用中位数绝对偏差识别异常值。", "description_en": "Detects outliers using median absolute deviation.", "input": {"data_type": "table", "slots": [{"id": "x_columns", "display_name": "定量变量", "display_name_en": "Quantitative Variables", "type": "columns", "required": true, "min_items": 1, "allowed_data_types": ["integer", "number"], "allowed_analysis_types": ["quantitative"]}], "constraints": []}, "parameters_schema": {"type": "object", "properties": {
          "action": {"type": "string", "title": "处置方式", "x-title-en": "Treatment", "enum": ["set_null", "custom_value", "mean", "median", "mode", "zero", "random_valid_value", "winsorize"], "oneOf": [{"const": "set_null", "title": "置为空值", "x-title-en": "Set as Missing"}, {"const": "custom_value", "title": "自定义值替换", "x-title-en": "Replace with Custom Value"}, {"const": "mean", "title": "均值替换", "x-title-en": "Replace with Mean"}, {"const": "median", "title": "中位数替换", "x-title-en": "Replace with Median"}, {"const": "mode", "title": "众数替换", "x-title-en": "Replace with Mode"}, {"const": "zero", "title": "数字 0 替换", "x-title-en": "Replace with Zero"}, {"const": "random_valid_value", "title": "随机有效值替换", "x-title-en": "Replace with Random Valid Value"}, {"const": "winsorize", "title": "缩尾处理", "x-title-en": "Winsorize"}], "default": "set_null"},
          "replacement_value": {"type": "number", "title": "自定义替换值", "x-title-en": "Custom Replacement Value", "x-visible-when": {"field": "action", "equals": "custom_value"}, "default": 0},
          "bounds": {"type": "object", "title": "字段边界覆盖", "x-title-en": "Per-variable Bounds", "x-ui-control": "json-editor", "default": {}},
          "threshold": {"type": "number", "title": "判断阈值", "x-title-en": "Detection Threshold", "description": "阈值越大，判定为异常的样本通常越少。", "x-description-en": "Larger values generally mark fewer samples as outliers.", "exclusiveMinimum": 0, "default": 3.5}
        }, "additionalProperties": false}, "output": {"data_type": "table", "produces_data_version": true}, "deterministic": true},
        {"method_id": "iqr", "display_name": "四分位距法", "display_name_en": "Interquartile Range (IQR)", "entry": "algorithms.outlier_handling:run_iqr", "description": "使用四分位距识别异常值。", "description_en": "Detects outliers using the interquartile range.", "input": {"data_type": "table", "slots": [{"id": "x_columns", "display_name": "定量变量", "display_name_en": "Quantitative Variables", "type": "columns", "required": true, "min_items": 1, "allowed_data_types": ["integer", "number"], "allowed_analysis_types": ["quantitative"]}], "constraints": []}, "parameters_schema": {"type": "object", "properties": {
          "action": {"type": "string", "title": "处置方式", "x-title-en": "Treatment", "enum": ["set_null", "custom_value", "mean", "median", "mode", "zero", "random_valid_value", "winsorize"], "oneOf": [{"const": "set_null", "title": "置为空值", "x-title-en": "Set as Missing"}, {"const": "custom_value", "title": "自定义值替换", "x-title-en": "Replace with Custom Value"}, {"const": "mean", "title": "均值替换", "x-title-en": "Replace with Mean"}, {"const": "median", "title": "中位数替换", "x-title-en": "Replace with Median"}, {"const": "mode", "title": "众数替换", "x-title-en": "Replace with Mode"}, {"const": "zero", "title": "数字 0 替换", "x-title-en": "Replace with Zero"}, {"const": "random_valid_value", "title": "随机有效值替换", "x-title-en": "Replace with Random Valid Value"}, {"const": "winsorize", "title": "缩尾处理", "x-title-en": "Winsorize"}], "default": "set_null"},
          "replacement_value": {"type": "number", "title": "自定义替换值", "x-title-en": "Custom Replacement Value", "x-visible-when": {"field": "action", "equals": "custom_value"}, "default": 0},
          "bounds": {"type": "object", "title": "字段边界覆盖", "x-title-en": "Per-variable Bounds", "x-ui-control": "json-editor", "default": {}},
          "k": {"type": "number", "title": "阈值系数", "x-title-en": "Threshold Multiplier", "description": "用于计算 Q1−k×IQR 与 Q3+k×IQR。", "x-description-en": "Used to calculate Q1−k×IQR and Q3+k×IQR.", "exclusiveMinimum": 0, "default": 1.5}
        }, "additionalProperties": false}, "output": {"data_type": "table", "produces_data_version": true}, "deterministic": true},
        {"method_id": "three_sigma", "display_name": "三倍标准差法", "display_name_en": "Three-sigma Rule", "entry": "algorithms.outlier_handling:run_three_sigma", "description": "使用均值加减标准差倍数识别异常值。", "description_en": "Detects outliers using multiples of the standard deviation around the mean.", "input": {"data_type": "table", "slots": [{"id": "x_columns", "display_name": "定量变量", "display_name_en": "Quantitative Variables", "type": "columns", "required": true, "min_items": 1, "allowed_data_types": ["integer", "number"], "allowed_analysis_types": ["quantitative"]}], "constraints": []}, "parameters_schema": {"type": "object", "properties": {
          "action": {"type": "string", "title": "处置方式", "x-title-en": "Treatment", "enum": ["set_null", "custom_value", "mean", "median", "mode", "zero", "random_valid_value", "winsorize"], "oneOf": [{"const": "set_null", "title": "置为空值", "x-title-en": "Set as Missing"}, {"const": "custom_value", "title": "自定义值替换", "x-title-en": "Replace with Custom Value"}, {"const": "mean", "title": "均值替换", "x-title-en": "Replace with Mean"}, {"const": "median", "title": "中位数替换", "x-title-en": "Replace with Median"}, {"const": "mode", "title": "众数替换", "x-title-en": "Replace with Mode"}, {"const": "zero", "title": "数字 0 替换", "x-title-en": "Replace with Zero"}, {"const": "random_valid_value", "title": "随机有效值替换", "x-title-en": "Replace with Random Valid Value"}, {"const": "winsorize", "title": "缩尾处理", "x-title-en": "Winsorize"}], "default": "set_null"},
          "replacement_value": {"type": "number", "title": "自定义替换值", "x-title-en": "Custom Replacement Value", "x-visible-when": {"field": "action", "equals": "custom_value"}, "default": 0},
          "bounds": {"type": "object", "title": "字段边界覆盖", "x-title-en": "Per-variable Bounds", "x-ui-control": "json-editor", "default": {}},
